# --- OpenRouter (Seedance / Veo video generation) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model slugs (override per-request from the UI)
OPENROUTER_SEEDANCE_MODEL=bytedance/seedance-1-pro
OPENROUTER_VEO_MODEL=google/veo-3
# Optional attribution headers OpenRouter encourages
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=heygen-clone

# --- ElevenLabs (TTS / voice cloning) ---
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2

# --- Cloudflare R2 (S3-compatible storage for generated assets) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=heygen-clone-assets
# Public URL prefix for served assets (R2 public bucket or custom domain)
R2_PUBLIC_BASE_URL=

# --- App ---
NEXT_PUBLIC_APP_NAME=AI Reels Studio
PORT=3000

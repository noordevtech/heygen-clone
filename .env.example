# --- OpenRouter (Seedance / Veo video generation) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model slugs (see https://openrouter.ai/collections/video-models)
# Other options: bytedance/seedance-2.0-fast, bytedance/seedance-1-5-pro (audio+lipsync)
OPENROUTER_SEEDANCE_MODEL=bytedance/seedance-2.0
OPENROUTER_VEO_MODEL=google/veo-3.1
# Optional attribution headers OpenRouter encourages
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=heygen-clone

# --- ElevenLabs (TTS / voice cloning) ---
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2

# --- Kie.ai (video / image / music generation) ---
# All four can also be set from the in-app /settings page.
KIE_API_KEY=
KIE_DEFAULT_VIDEO_MODEL=bytedance/seedance-2
KIE_DEFAULT_IMAGE_MODEL=google/nano-banana-pro
KIE_DEFAULT_MUSIC_MODEL=V5

# --- Pexels (free stock B-roll for the YouTube long-form generator) ---
PEXELS_API_KEY=

# --- Anthropic (Claude scene planner on the YouTube page) ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7

# --- Cloudflare R2 (S3-compatible storage for generated assets) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=heygen-clone-assets
# Public URL prefix for served assets (R2 public bucket or custom domain)
R2_PUBLIC_BASE_URL=

# --- Postgres (job persistence) ---
DATABASE_URL=postgres://user:pass@localhost:5432/reels

# --- Redis (BullMQ queue) ---
REDIS_URL=redis://localhost:6379

# --- App ---
NEXT_PUBLIC_APP_NAME=AI Reels Studio
APP_PUBLIC_URL=http://localhost:3000
PORT=3000
